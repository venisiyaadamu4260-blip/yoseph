jQuery(document).ready(function(){
  /* Open accordion items when clicking on their header */
  jQuery('.wp-features_item-heading').on('click', function () {
    const $item = jQuery(this).closest('.wp-features_item');
    const $panel = $item.find('.wp-features_item-content');

    $panel.slideToggle(400);
  });
  /* END Open accordion items when clicking on their header */

  /* Add class to header when scrolled */
  jQuery(function () {
    const header = jQuery('header');
    if (!header.length) return;

    function onScroll() {
      const y = window.scrollY || 0;
      header.toggleClass('is-scrolled', y > 0);
    }

    jQuery(window).on('scroll', onScroll);
    onScroll();
  });
  /* END Add class to header when scrolled */

  /* Add swiper */
  function forceSliderVideos() {
    const videos = document.querySelectorAll('.swiper-viously video.lazy');

    videos.forEach(function (video) {
      const dataSrc = video.getAttribute('data-src');
      const dataPoster = video.getAttribute('data-poster');

      if (dataSrc) {
        video.setAttribute('src', dataSrc);
        video.removeAttribute('data-src');
      }

      if (dataPoster) {
        video.setAttribute('poster', dataPoster);
        video.removeAttribute('data-poster');
      }

      const sources = video.querySelectorAll('source[data-src]');
      sources.forEach(function (source) {
        source.setAttribute('src', source.getAttribute('data-src'));
        source.removeAttribute('data-src');
      });

      video.load();
    });
  }

  if (jQuery('.swiper-viously').length) {
    const $sliderList = jQuery('.swiper-viously > .swiper-wrapper');
    const $originalList = jQuery('.swiper-viously > .swiper-wrapper > .swiper-slide');
    const originalSlideCount = $originalList.length;
    const targetCount = 6; // Desired total number of slides

    // Count current (non-cloned) slides
    const currentSlideCount = $sliderList.find('> li[data-cloned!=true]').length;
    // Calculate how many clones are needed to meet the target
    const neededClones = Math.max(0, Math.ceil((targetCount - currentSlideCount) / originalSlideCount));

    // Clone and append the necessary number of original slides
    for (let i = 0; i < neededClones; i++) {
      $originalList.each(function () {
        const $clone = jQuery(this).clone();
        $sliderList.append($clone);
      });
    }

    const swiper = new Swiper('.swiper-viously', {
      speed: 600,
      loop: true,
      // loopAdditionalSlides: 10,
      autoHeight: false,
      centeredSlides: true,
      followFinger: true,
      freeMode: false,
      slideToClickedSlide: false,
      slidesPerView: 3,
      spaceBetween: "10%",
      rewind: false,
      autoplay: {
        delay: 2000,
      },
      mousewheel: {
        forceToAxis: true
      },
      keyboard: {
        enabled: true,
        onlyInViewport: true
      },
      breakpoints: {
        // mobile landscape
        480: {
          slidesPerView: 3,
          spaceBetween: "10%"
        },
        // tablet
        768: {
          slidesPerView: 3,
          spaceBetween: "10%"
        },
        // desktop
        992: {
          slidesPerView: 5,
          spaceBetween: "5%"
        }
      },
      slideActiveClass: "is-active",
      slideDuplicateActiveClass: "is-active"
    });

    const sliderElement = document.querySelector('.swiper-viously');
    let sliderVideosForced = false;

    function runForceSliderVideosOnce() {
      if (sliderVideosForced) return;
      sliderVideosForced = true;
      forceSliderVideos();
      observer.disconnect();
    }

    const observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          runForceSliderVideosOnce();
        }
      });
    }, {
      root: null,
      rootMargin: "300px 0px",
      threshold: 0
    });

    if (sliderElement) {
      observer.observe(sliderElement);
    }
  }
  /* END Add swiper */
});